# ============================================================
# eljazari.ai - Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
#
# IMPORTANT: API_SECRET_KEY is REQUIRED and has NO default value in the code.
# The server will refuse to start if this variable is missing.
# Generate a strong random key (>= 32 chars):
#   python -c "import secrets; print(secrets.token_hex(32))"

# --- App ---
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=debug
ENABLE_API_DOCS=true
ALLOW_ANONYMOUS_AUTH=true
# POST /api/auth/token signs a JWT for any user_id with NO credential check.
# Development convenience only. Forced off when ENVIRONMENT=production; setting
# it true there makes the API refuse to start. See SECURITY.md.
ENABLE_DEV_TOKEN_ENDPOINT=true
ACCESS_TOKEN_EXPIRE_HOURS=168
# REQUIRED — no default in code. Must be at least 32 characters.
API_SECRET_KEY=change-me-generate-a-real-32-char-secret!!
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
ENABLE_HTTPS_REDIRECT=false

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://drone:drone@localhost:5432/droneprompt
POSTGRES_USER=drone
POSTGRES_PASSWORD=drone
POSTGRES_DB=droneprompt
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Ollama (Local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:latest
OLLAMA_CODE_MODEL=qwen2.5-coder:7b
OLLAMA_EVAL_MODEL=llama3.2:latest
# Dedicated embedding model for AircraftVerse RAG. A chat model cannot embed
# (Ollama returns HTTP 501), which silently disables RAG — keep this an
# embedder. Pull it with: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- AircraftVerse ---
# Relative paths are taken from the repository root (where this file lives),
# whichever directory the API or a script starts in.
AIRCRAFTVERSE_PATH=./data/aircraftverse/designs.json
AIRCRAFTVERSE_REQUIRE_REAL=false
# persistent: the retrieval index is built once (about 2 min, or ahead of time
# with `python -m scripts.prepare_assets --index`) and reused by every API
# process; memory: each process builds its own on its first design.
AIRCRAFTVERSE_RAG_MODE=persistent
# Optional base directory for the embedded SQLite retrieval index.
# AIRCRAFTVERSE_INDEX_PATH=./data/storage/chroma-local

# --- LangSmith (Observability) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=drone-prompt

# --- Gazebo Simulation ---
GAZEBO_MODEL_PATH=/simulation/gazebo/models
GAZEBO_WORLD_PATH=/simulation/gazebo/worlds
GAZEBO_MASTER_URI=http://localhost:11345
ROS_DOMAIN_ID=42

# --- PX4 SITL ---
# Project-prefixed variables accept both spellings: ELJAZARI_* is canonical and
# DRONEPROMPT_* is the legacy name, still honoured so existing .env files and
# prepared WSL environments keep working. ELJAZARI_* wins if both are set.
# The legacy spelling is used below purely to stay compatible with setups that
# already have it. See apps/api/config/env_names.py.
PX4_HOME_LAT=24.7136
PX4_HOME_LON=46.6753
PX4_HOME_ALT=620.0
MAVLINK_PORT=14550
MAVSDK_PORT=50051
# SITL runtime selection. "auto" (recommended) picks the best available:
# native PX4 on Linux, a WSL Ubuntu distro on Windows, or a running PX4 Docker
# container — and only then falls back to "mock" telemetry. Force one with
# "wsl" | "docker" | "native" | "mock". On Windows + WSL, "auto" needs no extra
# flags; the WSL probe retries while a cold distro boots.
DRONEPROMPT_SITL_RUNTIME=auto
# WSL settings (used when the runtime resolves to wsl):
DRONEPROMPT_WSL_DISTRO=Ubuntu
DRONEPROMPT_WSL_USER=droneprompt
DRONEPROMPT_WSL_PX4_DIR=/home/droneprompt/PX4-Autopilot
DRONEPROMPT_WSL_WORLDS_PATH=/home/droneprompt/PX4-Autopilot/Tools/simulation/gz/worlds
DRONEPROMPT_WSL_PYTHON_BIN=/home/droneprompt/droneprompt-mavsdk-venv/bin/python

# --- WebGCS / MAVLink bridge ---
# Where the ground station connects. Default is the PX4 SITL UDP port; use
# serial:///dev/ttyUSB0:57600 or tcp://<ip>:5760 for real hardware.
# Requires mavsdk (in requirements.txt, not requirements-ci.txt) — without it
# the bridge runs in stub mode and emits synthetic telemetry.
GCS_MAVLINK_ADDRESS=udp://:14540
GCS_CONNECT_TIMEOUT_S=30
GCS_TAKEOFF_ALTITUDE_M=10

# --- Frontend ---
# NOTE: Next.js does NOT read this file. It only loads env from apps/web/, so
# NEXT_PUBLIC_* set here reaches docker-compose and the backend but never the
# browser bundle. Configure the frontend in apps/web/.env.local instead —
# see apps/web/.env.example. Kept here because docker-compose passes them
# through to the web container as build args.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_PATH=./data/storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# --- Safety ---
MAX_ALTITUDE_M=120.0
MAX_SPEED_MS=15.0
MAX_GEOFENCE_RADIUS_M=500.0
MIN_BATTERY_PCT=20.0
MAX_SIMULATION_ITERATIONS=5
SIMULATION_PASS_THRESHOLD=50.0

# --- Flower (Celery task monitor) ---
# REQUIRED when running docker-compose: Flower now enforces HTTP Basic Auth.
# Dev defaults: admin / droneprompt  (set in docker-compose.dev.yml)
# Production:   set strong credentials here and in your secrets manager.
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-flower-password

# --- Production guidance ---
# ENVIRONMENT=production
# DEBUG=false
# ENABLE_API_DOCS=false
# ALLOW_ANONYMOUS_AUTH=false
# ENABLE_DEV_TOKEN_ENDPOINT=false   <- forced off in production regardless
# ACCESS_TOKEN_EXPIRE_HOURS=24
# NOTE: none of the above provides authentication. Front the API with an
# identity provider issuing JWTs signed with API_SECRET_KEY. See SECURITY.md.
# AIRCRAFTVERSE_REQUIRE_REAL=true
# AIRCRAFTVERSE_RAG_MODE=persistent
# CORS_ORIGINS=["https://app.example.com"]         <- no wildcards allowed
# TRUSTED_HOSTS=["api.example.com","app.example.com"]
# ENABLE_HTTPS_REDIRECT=true
# FLOWER_USER=admin
# FLOWER_PASSWORD=<strong-random-password>


# auto: PostgreSQL in production, volatile memory in development
# Use postgres explicitly to test restart persistence in development.
CHECKPOINT_BACKEND=auto

# Private local import; omitted from public archives and images.
COMPONENTS_CATALOG_PATH=.local/components
