# Frontend environment — copy to apps/web/.env.local
#
#   cp apps/web/.env.example apps/web/.env.local
#
# IMPORTANT: these must live HERE, not in the repository-root .env. Next.js only
# reads env files from the app directory, so NEXT_PUBLIC_* set at the repo root
# reaches the FastAPI backend but never the frontend.
#
# Every value below is optional — the defaults in lib/config.ts already point at
# the backend the README quick start starts (http://localhost:8000). Copy this
# file only when your backend runs somewhere else.

# REST base URL for the FastAPI backend.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Socket.io origin. Defaults to NEXT_PUBLIC_API_URL — the two are the same
# process, since Socket.io is mounted on the FastAPI app at /socket.io.
# Use an http(s) origin, not ws(s): the client negotiates the upgrade itself.
# NEXT_PUBLIC_WS_URL=http://localhost:8000

# Optional Mapbox token for the GCS map view. Leave empty to use the default
# OpenStreetMap tiles.
# NEXT_PUBLIC_MAPBOX_TOKEN=
