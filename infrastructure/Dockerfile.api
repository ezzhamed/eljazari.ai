FROM python:3.11-slim AS deps

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt


FROM python:3.11-slim AS runtime

LABEL org.opencontainers.image.source="https://github.com/ezzhamed/eljazari.ai"
LABEL org.opencontainers.image.description="eljazari.ai FastAPI backend"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system --gid 1001 appgroup \
    && adduser --system --uid 1001 --ingroup appgroup appuser

COPY --from=deps /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin

COPY apps/api/ .
COPY data/ /app/data/

RUN chown -R appuser:appgroup /app

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# One worker by default. More (ELJAZARI_API_WORKERS) require the Redis Socket.IO
# queue and PostgreSQL checkpoints, which the settings validate at startup, and
# sticky sessions or WebSocket-only clients for Engine.IO long-polling.
ENV ELJAZARI_API_WORKERS=1
CMD ["sh", "-c", "exec uvicorn main:socket_app --host 0.0.0.0 --port 8000 --workers \"${ELJAZARI_API_WORKERS}\" --log-level info --proxy-headers --forwarded-allow-ips '*'"]
